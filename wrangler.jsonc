// Cloudflare Workers config for the kod.felisai.pro landing page.
//
// WHY THIS EXISTS: Cloudflare has merged Workers and Pages, and the current
// "Connect to Git" flow lands in WORKERS BUILDS, which asks for a deploy command
// (`npx wrangler deploy`) instead of Pages' "build output directory" field. That
// command needs this file to know what to publish — without it the deploy has no
// idea `site/` is the thing to serve.
//
// There is no `main`, deliberately: this is a STATIC-ASSETS-ONLY Worker. No
// server code runs, nothing is bundled, and the whole deploy is the contents of
// site/. If a Worker script is ever added, `main` points at it and the assets
// binding keeps serving the page underneath.
{
  "name": "kod",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./site"
  },

  // The custom domain, declared here rather than clicked once in the dashboard —
  // so it is versioned, reviewable, and reapplied by every deploy instead of
  // being invisible state someone has to remember.
  //
  // `custom_domain: true` makes Cloudflare do the DNS itself: because felisai.pro
  // is already a zone on this account, deploying PROVISIONS the record and the
  // TLS certificate. There is no CNAME to add by hand, and pointing one at a
  // Worker manually does not work anyway — a Worker is not an origin.
  "routes": [
    { "pattern": "kod.felisai.pro", "custom_domain": true }
  ]
}
